{
  "triggers": [
    {
      "id": "lr5_visit",
      "title": {
        "en": "A pet visit is recorded",
        "nl": "Een huisdierbezoek is geregistreerd"
      },
      "tokens": [
        {
          "name": "pet_id",
          "type": "string",
          "title": {
            "en": "Pet ID",
            "nl": "Huisdier-ID"
          }
        },
        {
          "name": "pet_name",
          "type": "string",
          "title": {
            "en": "Pet name",
            "nl": "Naam van huisdier"
          }
        },
        {
          "name": "pet_identified",
          "type": "boolean",
          "title": {
            "en": "Single pet identified",
            "nl": "Eén huisdier herkend"
          }
        },
        {
          "name": "weight",
          "type": "number",
          "title": {
            "en": "Weight (g)",
            "nl": "Gewicht (g)"
          }
        },
        {
          "name": "has_weight",
          "type": "boolean",
          "title": {
            "en": "Weight available",
            "nl": "Gewicht beschikbaar"
          }
        },
        {
          "name": "duration",
          "type": "number",
          "title": {
            "en": "Duration (seconds)",
            "nl": "Duur (seconden)"
          }
        },
        {
          "name": "has_duration",
          "type": "boolean",
          "title": {
            "en": "Duration available",
            "nl": "Duur beschikbaar"
          }
        },
        {
          "name": "waste_type",
          "type": "string",
          "title": {
            "en": "Waste type",
            "nl": "Type ontlasting"
          }
        },
        {
          "name": "waste_weight",
          "type": "number",
          "title": {
            "en": "Waste weight (g)",
            "nl": "Gewicht van ontlasting (g)"
          }
        },
        {
          "name": "has_waste_weight",
          "type": "boolean",
          "title": {
            "en": "Valid waste weight",
            "nl": "Geldig ontlastingsgewicht"
          }
        },
        {
          "name": "visit_time",
          "type": "string",
          "title": {
            "en": "Visit time (ISO)",
            "nl": "Tijd van bezoek (ISO)"
          }
        },
        {
          "name": "delayed",
          "type": "boolean",
          "title": {
            "en": "Recovered after a delay",
            "nl": "Met vertraging opgehaald"
          }
        }
      ],
      "hint": {
        "en": "Uses Whisker activity history. Events may arrive later; initial history is not replayed. Missing measurements are 0 with their availability flag false.",
        "nl": "Gebruikt de Whisker-bezoekgeschiedenis. Gebeurtenissen kunnen later binnenkomen; de eerste geschiedenis wordt niet afgespeeld. Ontbrekende metingen zijn 0 en hun beschikbaarheidsvlag is onwaar."
      }
    },
