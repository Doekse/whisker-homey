  "conditions": [
    {
      "id": "lr5_pet_visited_today",
      "title": {
        "en": "A specific pet has visited today",
        "nl": "Een gekozen huisdier is vandaag geweest"
      },
      "args": [
        {
          "name": "pet",
          "type": "autocomplete",
          "title": {
            "en": "Pet",
            "nl": "Huisdier"
          }
        }
      ],
      "hint": {
        "en": "An incomplete history cannot prove that no visit occurred.",
        "nl": "Een onvolledige geschiedenis kan niet aantonen dat er geen bezoek was."
      },
      "titleFormatted": {
        "en": "[[pet]] has visited today",
        "nl": "[[pet]] is vandaag geweest"
      }
    },
    {
      "id": "lr5_filter_due_condition",
