  "actions": [
    {
      "id": "lr5_set_sleep_schedule",
      "title": {
        "en": "Set sleep schedule",
        "nl": "Slaapschema instellen"
      },
      "titleFormatted": {
        "en": "Sleep on [[day]] from [[start]] until [[end]]",
        "nl": "Slapen op [[day]] van [[start]] tot [[end]]"
      },
      "args": [
        {
          "name": "day",
          "type": "dropdown",
          "title": {
            "en": "Day",
            "nl": "Dag"
          },
          "values": [
            {
              "id": "all",
              "label": {
                "en": "Every day",
                "nl": "Iedere dag"
              }
            },
            {
              "id": "0",
              "label": {
                "en": "Sunday",
                "nl": "Zondag"
              }
            },
            {
              "id": "1",
              "label": {
                "en": "Monday",
                "nl": "Maandag"
              }
            },
            {
              "id": "2",
              "label": {
                "en": "Tuesday",
                "nl": "Dinsdag"
              }
            },
            {
              "id": "3",
              "label": {
                "en": "Wednesday",
                "nl": "Woensdag"
              }
            },
            {
              "id": "4",
              "label": {
                "en": "Thursday",
                "nl": "Donderdag"
              }
            },
            {
              "id": "5",
              "label": {
                "en": "Friday",
                "nl": "Vrijdag"
              }
            },
            {
              "id": "6",
              "label": {
                "en": "Saturday",
                "nl": "Zaterdag"
              }
            }
          ]
        },
        {
          "name": "start",
          "type": "text",
          "title": {
            "en": "Start (HH:mm)",
            "nl": "Begin (HH:mm)"
          },
          "placeholder": {
            "en": "23:00",
            "nl": "23:00"
          }
        },
        {
          "name": "end",
          "type": "text",
          "title": {
            "en": "End (HH:mm)",
            "nl": "Einde (HH:mm)"
          },
          "placeholder": {
            "en": "07:00",
            "nl": "07:00"
          }
        }
      ],
      "hint": {
        "en": "Uses the robot's timezone. For an overnight window, choose the wake-up day (Sunday=0 in the API). Other days are preserved.",
        "nl": "Gebruikt de tijdzone van de robot. Kies bij een nachtelijk tijdvak de dag van wakker worden (zondag=0 in de API). Andere dagen blijven behouden."
      }
    },
